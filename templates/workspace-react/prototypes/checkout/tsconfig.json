{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "@cogitato/runtime/client"],
    "paths": { "@/kit/*": ["../../kit/*"], "@/*": ["./src/*"] }
  },
  "include": ["src", "../../kit", "vite.config.ts"]
}
