{
  "name": "@cogitato/canvas",
  "version": "0.2.0",
  "description": "The Cogitato canvas: every screen state of a prototype as a live frame, laid out as its flows",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitato/cogitato.git",
    "directory": "packages/canvas"
  },
  "homepage": "https://github.com/cogitato/cogitato/tree/main/packages/canvas#readme",
  "bugs": "https://github.com/cogitato/cogitato/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
