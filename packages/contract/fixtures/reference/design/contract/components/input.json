{
  "$schema": "../../../../../schema/component.schema.json",
  "name": "Input",
  "description": "Single-line text field with a label, hint and error message.",
  "source": "production",
  "confidence": "high",
  "import": "@/kit/Input",
  "props": {
    "label": { "type": "string", "required": true },
