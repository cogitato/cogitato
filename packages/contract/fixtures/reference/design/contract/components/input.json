    "placeholder": { "type": "string" },
    "hint": { "type": "string", "description": "Help text shown under the field." },
    "error": { "type": "string", "description": "Error text. Setting it shows the error state." },
    "disabled": { "type": "boolean", "default": false },
    "onChange": { "type": "event" }
  },
  "states": ["default", "focus", "filled", "error", "disabled"],
  "rules": [
    "Always set a label, even if it is visually hidden.",
    "Error messages say how to fix the problem."
  ],
  "mapping": {
    "production": { "path": "src/ui/forms/TextInput.tsx", "export": "TextInput" },
