{
  "$schema": "../../../../schema/tokens.schema.json",
  "color": {
    "$type": "color",
    "brand": {
      "50": { "$value": "#eff6ff", "$description": "Brand Blue 50" },
      "100": { "$value": "#dbeafe", "$description": "Brand Blue 100" },
      "500": { "$value": "#3b82f6", "$description": "Brand Blue 500" },
      "600": { "$value": "#2563eb", "$description": "Brand Blue 600" },
      "700": { "$value": "#1d4ed8", "$description": "Brand Blue 700" }
    },
    "neutral": {
      "0": { "$value": "#ffffff", "$description": "White" },
      "50": { "$value": "#f8fafc", "$description": "Neutral 50" },
      "100": { "$value": "#f1f5f9", "$description": "Neutral 100" },
      "200": { "$value": "#e2e8f0", "$description": "Neutral 200" },
      "500": { "$value": "#64748b", "$description": "Neutral 500" },
      "700": { "$value": "#334155", "$description": "Neutral 700" },
      "900": { "$value": "#0f172a", "$description": "Neutral 900" }
    },
    "feedback": {
      "success": { "$value": "#15803d", "$description": "Success green" },
      "warning": { "$value": "#b45309", "$description": "Warning amber" },
      "danger": { "$value": "#b91c1c", "$description": "Danger red" },
      "danger-subtle": { "$value": "#fef2f2", "$description": "Danger background" },
      "info": { "$value": "{color.brand.600}", "$description": "Info uses brand blue" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.500}" },
      "inverse": { "$value": "{color.neutral.0}" },
      "danger": { "$value": "{color.feedback.danger}" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.0}" },
      "subtle": { "$value": "{color.neutral.50}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "focus": { "$value": "{color.brand.500}" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale. Use for padding, margins and gaps.",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 20, "unit": "px" } },
      "xl": { "$value": { "value": 28, "unit": "px" } }
    }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": 1.4
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.2,
        "letterSpacing": { "value": -0.02, "unit": "rem" }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "#0f172a1a",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 3, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "normal": { "$value": { "value": 200, "unit": "ms" } }
  }
}
