{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.local/schema/flows.schema.json",
  "title": "FlowManifest",
  "description": "design/flows.json: every screen, state and flow in a prototype. Generated by `kit export-flows`; the canvas reads only this file. Frame URL: {baseUrl}{route}?fixture={fixture}&kit-frame=1",
  "type": "object",
  "required": ["schemaVersion", "screens", "flows"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "commit": { "$ref": "common.schema.json#/$defs/commit" },
    "screens": {
      "type": "array",
      "items": { "$ref": "#/$defs/screen" }
    },
    "flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/flow" }
    },
    "status": {
      "description": "Review status per node ({screenId}.{stateId}). Nodes not listed are \"exploring\".",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/nodeRef" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/frameStatus" }
    }
  },
  "$defs": {
    "screen": {
      "title": "Screen",
      "type": "object",
      "required": ["id", "route", "title", "states"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/screenId" },
        "route": {
          "type": "string",
          "pattern": "^/",
          "x-hint": "Routes start with \"/\", like \"/checkout/payment\"."
        },
        "title": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state" }
        }
      }
    },
    "state": {
      "title": "ScreenState",
      "type": "object",
      "required": ["id", "fixture", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "fixture": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "flow": {
      "title": "Flow",
      "type": "object",
      "required": ["id", "title", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeRef" },
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "edge": {
      "title": "FlowEdge",
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/nodeRef" },
        "to": { "$ref": "common.schema.json#/$defs/nodeRef" },
        "label": { "type": "string" }
      }
    }
  }
}
